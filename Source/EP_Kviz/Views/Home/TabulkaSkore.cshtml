@model List<EP_Kviz.Models.UzivateleModel>
@{
 ViewData["Title"] = "Tabulka skóre";
 Layout = "~/Views/Shared/_Layout.cshtml";
}


<div style="width:100%; display:flex; justify-content:center; padding:2rem0;">
 <div style="max-width:900px; width:70%;">
 <h1 style="text-align:center; margin-bottom:1rem;">Tabulka výher</h1>

 <table style="width:100%; max-width:900px; border-collapse: collapse; margin-top:1rem;">
 <thead>
 <tr style="background:#0088ff; color:white;">
 <th style="padding:8px; text-align:left;">#</th>
 <th style="padding:8px; text-align:left;">Uživatel</th>
 <th style="padding:8px; text-align:left;">Poèet výher</th>
 <th style="padding:8px; text-align:left;">Poèet odehraných her</th>
 </tr>
 </thead>
 <tbody>
 @for (int i =0; i < Model.Count; i++)
 {
 <tr style="border-bottom:1px solid #eee; color: #fff;">
 <td style="padding:8px;">@(i+1)</td>
 <td style="padding:8px;">@Model[i].UserName</td>
 <td style="padding:8px;">@Model[i].PocetVyhranychHer</td>
 <td style="padding:8px;">@Model[i].PocetOdehranychHer</td>
 </tr>
 }
 </tbody>
 </table>

 <a href="/Home/Index" class="home-button" style="margin-top:1.2rem; display:inline-block;">Zpìt</a>
 </div>
</div>

<style>

    .home-button {
        position: absolute;
        top: 24px;
        right: 32px;
        padding: 0.7rem 1.4rem;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 700;
        background: linear-gradient(180deg,#00f2ff,#0088ff);
        color: #fff;
        text-decoration: none;
        box-shadow: 0 0 10px rgba(0,136,255,0.5);
        transition: transform .15s, box-shadow .15s;
        z-index: 10;
    }
</style>