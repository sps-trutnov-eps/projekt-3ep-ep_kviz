@{
    ViewData["Title"] = "EPKvíz";
    Layout = null;
}

<!doctype html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            height: 100%;
            width: 100%;
        }

        body {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            font-family: "Orbitron", sans-serif;
            background: radial-gradient(circle at center, #0f172a 0%, #020617 100%);
            color: #fff;
        }

        h1 {
            font-size: 3rem;
            margin-bottom: 2rem;
            text-shadow: 0 0 12px rgba(0,255,255,0.6);
        }
    </style>
</head>

<body>
    <h1>EPKvíz - Pravidla</h1>
    <p>Pravidla hry:</p>
    <ul>
        <li>Hra obsahuje otázeky z SPŠ Trutnov.</li>
        <li>Každá otázka má svoje pole v herním poli.</li>
        <li>Za každou správnou odpověď získáte danne pole.</li>
        <li>Na každou otázku máte 1 minutu na odpověď.</li>
        <li>Za každou špatně se pole mění na černé otázky Ano/Ne.</li>
        <li>Hra končí, když tým nebo hráč spojí všechny strany herního pole.</li>
        <li>Hodně štěstí!</li>
</body>
</html>
