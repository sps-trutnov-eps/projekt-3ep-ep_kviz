@{
    ViewData["Title"] = "EPKvíz";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<head>
     <style>
        .home-button {
        position: absolute;
        top: 24px;
        right: 32px;
        padding: 0.7rem 1.4rem;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 700;
        background: linear-gradient(180deg,#00f2ff,#0088ff);
        color: #fff;
        text-decoration: none;
        box-shadow: 0 0 10px rgba(0,136,255,0.5);
        transition: transform .15s, box-shadow .15s;
        z-index: 10;
        }

        .home-button:hover {
        transform: scale(1.07);
        box-shadow: 0 0 18px rgba(0,242,255,0.8);
        }

        .pozadi{
            color: white;
            accent-color: #00f2ff;
            background: linear-gradient(135deg, #0088ff 0%, #00f2ff 100%);
            padding: 2rem;
            border-radius: 12px;
        }
    </style>
</head>

<body>
    <h1>Pravidla</h1>
    <a href="/Home/Index" class="home-button">Zpět</a>
    <div class="pozadi">
        <p>Pravidla hry:</p>
        <ul>
            <li>Hra obsahuje otázky z SPŠ Trutnov.</li>
            <li>Každá otázka má svoje pole v herním poli.</li>
            <li>Za každou správnou odpověď získáte danné pole.</li>
            <li>Za každou špatně se pole mění na černé otázky.</li>
            <li>Herní módy:</li>
            <li>Procvičování - Cvičte si otázky a propojte všechny strany</li>
            <li>1v1 - Soupeří dva hráči a snaží se spojit všechny strany</li>
            <li>2v2 - Soupeří dva tými po dvou hráčích pro propojení čtyř stran</li>
            <li>Duel - Hrajete dokud někdo neodpoví špatně</li>
            <li>FullBlock - Musíte zaplnit celé herní pole a vyhrává hráč s více polemy</li>
            <li>Hodně štěstí!</li>
        </ul>
    </div>
</body>
