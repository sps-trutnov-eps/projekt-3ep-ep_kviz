@{
    ViewData["Title"] = "EPKvíz";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>
    <style>
        nav {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            width: 220px;
        }

        .button {
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            padding: 1rem;
            border-radius: 12px;
            font-size: 1.2rem;
            font-weight: 700;
            background: linear-gradient(180deg,#00f2ff,#0088ff);
            color: #fff;
            box-shadow: 0 0 14px rgba(0,136,255,0.6);
            transition: transform .15s ease, box-shadow .15s ease;
        }

            .button:hover {
                transform: scale(1.05);
                box-shadow: 0 0 20px rgba(0,242,255,0.9);
            }

            .button:active {
                transform: scale(0.97);
            }
        .login-button {
            position: absolute;
            top: 24px;
            right: 32px;
            padding: 0.7rem 1.4rem;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 700;
            background: linear-gradient(180deg,#00f2ff,#0088ff);
            color: #fff;
            text-decoration: none;
            box-shadow: 0 0 10px rgba(0,136,255,0.5);
            transition: transform .15s, box-shadow .15s;
            z-index: 10;
        }

            .login-button:hover {
                transform: scale(1.07);
                box-shadow: 0 0 18px rgba(0,242,255,0.8);
            }

        .register-button {
            position: absolute;
            top: 24px;
            right: 200px; 
            padding: 0.7rem 1.4rem;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 700;
            background: linear-gradient(180deg,#00f2ff,#0088ff);
            color: #fff;
            text-decoration: none;
            box-shadow: 0 0 10px rgba(0,136,255,0.5);
            transition: transform .15s, box-shadow .15s;
            z-index: 10;
        }

        .logout-button {
            position: absolute;
            top: 24px;
            right: 368px;
            padding: 0.7rem 1.4rem;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 700;
            background: linear-gradient(180deg,#00f2ff,#0088ff);
            color: #fff;
            text-decoration: none;
            box-shadow: 0 0 10px rgba(0,136,255,0.5);
            transition: transform .15s, box-shadow .15s;
            z-index: 10;
        }

            .register-button:hover {
                transform: scale(1.07);
                box-shadow: 0 0 18px rgba(0,242,255,0.8);
            }
    </style>
</head>

<body>
    <a href="/Uzivatele/Login" class="login-button">Přihlásit se</a>
    <a href="/Uzivatele/Register" class="register-button">Registrace</a>
    <a href="/Uzivatele/Logout" class="logout-button">Odhlásit se</a>
    @ViewBag.Message
 


    <h1>EPKvíz</h1>
    <nav>
        <a href="/Games/Vyber" class="button">Hrát</a>
        <a href="/Home/Pravidla" class="button">Pravidla</a>
        <a href="/Home/TabulkaSkore" class="button">Tabulka skóre</a>
        <a href="/Home/Privacy" class="button">Ochrana osobních údajů</a> 
    </nav> 
</body>

