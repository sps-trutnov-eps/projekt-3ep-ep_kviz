@model RegisterViewModel

@{
    ViewData["Title"] = "EPKvíz - Registrace";
    Layout = null;
}

<!doctype html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            height: 100%;
            width: 100%;
        }

        body {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            font-family: "Orbitron", sans-serif;
            background: radial-gradient(circle at center, #0f172a 0%, #020617 100%);
            color: #fff;
            font-size: 1.25rem;
        }

        h1 {
            font-size: 3rem;
            margin-bottom: 2rem;
            text-shadow: 0 0 12px rgba(0,255,255,0.6);
        }

        .home-button {
            position: absolute;
            top: 24px;
            right: 32px;
            padding: 0.7rem 1.4rem;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 700;
            background: linear-gradient(180deg,#00f2ff,#0088ff);
            color: #fff;
            text-decoration: none;
            box-shadow: 0 0 10px rgba(0,136,255,0.5);
            transition: transform .15s, box-shadow .15s;
            z-index: 10;
        }

            .home-button:hover {
                transform: scale(1.07);
                box-shadow: 0 0 18px rgba(0,242,255,0.8);
            }

        form {
            display: flex;
            flex-direction: column;
            gap: 1.2rem;
            min-width: 320px;
            margin-top: 1.5rem;
            font-size: 1.2rem;
        }

        form div {
            display: flex;
            flex-direction: column;
            align-items: stretch;
            gap: 0.5rem;
        }

        label {
            font-size: 1.1em;
            margin-bottom: 0.2em;
        }

        input[type="text"],
        input[type="password"],
        input[type="email"] {
            padding: 0.7em 1em;
            border-radius: 6px;
            border: none;
            font-size: 1.1em;
            background: #1e293b;
            color: #fff;
            box-shadow: 0 0 6px rgba(0,255,255,0.1);
            outline: none;
            transition: box-shadow 0.2s;
        }

        input[type="text"]:focus,
        input[type="password"]:focus,
        input[type="email"]:focus {
            box-shadow: 0 0 12px rgba(0,255,255,0.3);
        }

        button[type="submit"] {
            margin-top: 0.5em;
            padding: 0.8em 1.5em;
            border-radius: 8px;
            border: none;
            background: linear-gradient(180deg,#00f2ff,#0088ff);
            color: #fff;
            font-size: 1.2em;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 0 10px rgba(0,136,255,0.5);
            transition: transform .15s, box-shadow .15s;
        }

        button[type="submit"]:hover {
            transform: scale(1.05);
            box-shadow: 0 0 18px rgba(0,242,255,0.8);
        }

        p {
            margin-top: 1em;
            font-size: 1.1em;
      }

        /* Přidání společných stylů pro formulář */
        form {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            width: 300px;
        }

        input {
            padding: 0.7rem;
            border: none;
            border-radius: 4px;
            font-size: 1rem;
        }

        button {
            padding: 0.7rem;
            border: none;
            border-radius: 4px;
            font-size: 1rem;
            font-weight: 700;
            color: #fff;
            background: linear-gradient(180deg,#00f2ff,#0088ff);
            cursor: pointer;
            transition: background .15s;
        }

            button:hover {
                background: linear-gradient(180deg,#0088ff,#00f2ff);
            }
</style>
</head>
<body>
    <div class="container">
        <h1>Registrace</h1>
        <form method="post">
            <input asp-for="Username" placeholder="Uživatelské jméno" />
            <input asp-for="Password" type="password" placeholder="Heslo" />
            <button type="submit">Registrovat</button>
        </form>
        <a href="/Home/Index" class="home-button">Zpět na hlavní stránku</a>
    </div>
</body>
</html>
