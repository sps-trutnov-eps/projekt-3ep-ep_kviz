@model LoginViewModel

@{
    ViewData["Title"] = "EPKvíz - Přihlášení";
    Layout = null;
}

<!doctype html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            height: 100%;
            width: 100%;
        }

        body {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column; /* match Register layout */
            font-family: "Orbitron", sans-serif;
            background: radial-gradient(circle at center, #0f172a 0%, #020617 100%);
            color: #fff;
        }

        /* Keep container layout but remove the visual "frame" */
        .container {
            padding: 2rem;
            border-radius: 12px;
            text-align: center;
            width: 100%;
            max-width: 400px;
            background: transparent;     /* removed colored background */
            box-shadow: none;            /* removed frame / glow */
        }

        h1 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            text-shadow: 0 0 12px rgba(0,255,255,0.6);
        }

        form {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            width: 100%;
        }

        input {
            padding: 0.7rem;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            width: 100%;
        }

        button {
            padding: 0.7rem;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 700;
            background: linear-gradient(180deg,#00f2ff,#0088ff);
            color: #fff;
            cursor: pointer;
            transition: transform .15s, box-shadow .15s;
        }

        button:hover {
            transform: scale(1.05);
            box-shadow: 0 0 18px rgba(0,242,255,0.8);
        }

        /* Make the back button match Register: positioned top-right */
        .home-button {
            position: absolute;
            top: 24px;
            right: 32px;
            padding: 0.7rem 1.4rem;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 700;
            background: linear-gradient(180deg,#00f2ff,#0088ff);
            color: #fff;
            text-decoration: none;
            box-shadow: 0 0 10px rgba(0,136,255,0.5);
            transition: transform .15s, box-shadow .15s;
            z-index: 10;
        }

        .home-button:hover {
            transform: scale(1.07);
            box-shadow: 0 0 18px rgba(0,242,255,0.8);
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Přihlášení</h1>
@*         <form method="post">
            <input asp-for="Username" placeholder="Uživatelské jméno" />
            <input asp-for="Password" type="password" placeholder="Heslo" />
            <button type="submit">Přihlásit</button>
        </form> *@

        <form asp-action="Login" method="post">
            <div class="form-group">
                <label asp-for="Username">Uživatelské jméno</label>
                <input asp-for="Username" class="form-control" />

            </div>
            <div class="form-group">
                <label asp-for="Password">Uživatelské jméno</label>
                <input asp-for="Password" class="form-control" />

            </div>
            <button type="submit" class="btn btn-primary">Přihlásit se</button>

        </form>



    </div>

    <a href="/Home/Index" class="home-button">Zpět na hlavní stránku</a>
</body>
</html>
