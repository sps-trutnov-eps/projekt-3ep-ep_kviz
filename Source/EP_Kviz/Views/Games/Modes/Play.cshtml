@{
    var gameId = ViewBag.GameId;
    var mode = ViewBag.Mode;
    var playerId = ViewBag.PlayerId;
    var players = ViewBag.Players as List<int>;
    var playerCount = ViewBag.PlayerCount;
}

<h1>Mód: @mode</h1>

<div style="background: #f0f0f0; padding: 1rem; border-radius: 8px; margin-bottom: 1rem;">
    <p><strong>ID hry:</strong> @gameId</p>
    <p><strong>Tvoje ID:</strong> @playerId</p>
    <p><strong>Počet hráčů:</strong> @playerCount</p>
    <p><strong>Hráči v lobbyi:</strong> @string.Join(", ", players)</p>
</div>

<div style="background: #fff3cd; padding: 1rem; border-radius: 8px; margin-bottom: 1rem;">
    <p>🔗 <strong>Sdílej toto ID s přáteli:</strong> <code style="font-size: 1.5rem; font-weight: bold;">@gameId</code></p>
    <p>Můžou se připojit na hlavní stránce zadáním tohoto ID.</p>
</div>

<div>
    <h2>Hra začíná...</h2>
    <p>Zde bude vaše herní logika</p>
    <!-- TODO: Přidat herní logiku -->
</div>

<style>
    code {
        background: #e9ecef;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
    }
</style>