@{
    var gameId = ViewBag.GameId;
    var mode = ViewBag.Mode;
    var playerId = ViewBag.PlayerId;
    var players = ViewBag.Players as List<int>;
    var playerCount = ViewBag.PlayerCount;
}

<h1>Mód: @mode</h1>

<div style="background: #8AAAEB; padding: 1rem; border-radius: 8px; margin-bottom: 1rem;">
    <p><strong>ID hry:</strong> <span id="gameId">@gameId</span></p>
    <p><strong>Tvoje ID:</strong> <span id="myId">@playerId</span></p>
    <p><strong>Počet hráčů:</strong> <span id="playerCount">@playerCount</span></p>
    <p><strong>Hráči v lobbyi:</strong> <span id="playerList">@string.Join(", ", players)</span></p>
</div>

<div style="background: #f1f3f5; padding: 1rem; border-radius: 8px; margin-bottom: 1rem;">
    <h3>Skóre</h3>
    <ul id="scoreList">
        @if (players != null)
        {
            foreach (var p in players)
            {
                <li id="score_@p">@p: 0</li>
            }
        }
    </ul>

    <button id="addPointBtn" type="button" style="padding:0.6rem 1rem; border-radius:8px; background:#00a; color:#fff; border:none; cursor:pointer;" onclick="addPoint()">Přidat bod (pro Tebe)</button>
</div>

<div style="background: #405A99; padding: 1rem; border-radius: 8px; margin-bottom: 1rem;">
    <p>🔗 <strong>Sdílej toto ID s přáteli:</strong> <code style="font-size: 1.2rem; font-weight: bold; background: #8AAAEB;">@gameId</code></p>
    <p>Můžou se připojit na hlavní stránce zadáním tohoto ID.</p>
</div>

<div>
    <h2>Hra (test)</h2>
    <p>Pro demonstraci: stiskni tlačítko pro získání bodu. Stav se obnovuje každou sekundu.</p>
</div>

<script>
    // embed playerId as a JS number
    const playerId = @playerId;

    // Update UI helper
    function updateUI(data) {
        if (!data) return;
        document.getElementById('playerCount').textContent = data.playerCount ?? document.getElementById('playerCount').textContent;
        if (data.players) document.getElementById('playerList').textContent = data.players.join(', ');

        const scores = data.scores || {};
        const scoreList = document.getElementById('scoreList');
        scoreList.innerHTML = '';

        // Ensure players order
        const players = data.players || [];
        if (players.length === 0) {
            // fallback: iterate scores
            for (const [id, s] of Object.entries(scores)) {
                const li = document.createElement('li');
                li.textContent = `${id}: ${s}`;
                if (parseInt(id) === parseInt(playerId)) li.style.fontWeight = '700';
                scoreList.appendChild(li);
            }
        } else {
            for (const id of players) {
                const sc = scores[id] ?? 0;
                const li = document.createElement('li');
                li.id = `score_${id}`;
                li.textContent = `${id}: ${sc}`;
                if (parseInt(id) === parseInt(playerId)) li.style.fontWeight = '700';
                scoreList.appendChild(li);
            }
        }
    }

    // Poll game info every second
    setInterval(async function () {
        try {
            const gameId = document.getElementById('gameId').textContent;
            const response = await fetch(`/Games/GetGameInfo?gameId=${gameId}`);
            const data = await response.json();

            if (!data.error) {
                updateUI(data);
            }
        } catch (err) {
            console.error('Chyba při načítání dat:', err);
        }
    }, 1000);

    // Adds a point for the current player (test action)
    async function addPoint() {
        try {
            const gameId = document.getElementById('gameId').textContent;
            const response = await fetch(`/Games/AddPoint?gameId=${gameId}&pid=${playerId}`);
            const data = await response.json();

            if (data.error) {
                console.error('AddPoint error:', data.error);
                return;
            }

            updateUI({ players: data.players, scores: data.scores, playerCount: data.players.length });
        } catch (err) {
            console.error('Chyba při odesílání bodu:', err);
        }
    }
</script>

<style>
    code {
        background: #e9ecef;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
    }
</style>