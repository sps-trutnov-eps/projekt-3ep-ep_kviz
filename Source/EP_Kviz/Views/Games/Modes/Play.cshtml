@{
    ViewData["Title"] = "EPKvíz - " + ViewBag.Mode;
    Layout = null;
    var gameId = ViewBag.GameId;
    var playerId = ViewBag.PlayerId;
    var mode = ViewBag.Mode;
    var players = ViewBag.Players as List<int> ?? new List<int>();
    var playerCount = ViewBag.PlayerCount ?? 0;
}

<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&display=swap" rel="stylesheet">
    
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            height: 100%;
            width: 100%;
        }

        body {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            font-family: "Orbitron", sans-serif;
            background: radial-gradient(circle at center, #0f172a 0%, #020617 100%);
            color: #fff;
            padding: 2rem;
        }

        h1 {
            font-size: 2.5rem;
            margin-bottom: 1.5rem;
            text-shadow: 0 0 12px rgba(0,255,255,0.6);
        }

        .cellButton { 
            width: 100%; 
            height: 72px; 
            min-height: 56px; 
            font-family: "Orbitron", sans-serif;
        }
        
        .button { 
            padding: .6rem 1rem; 
            border-radius: 8px; 
            background: linear-gradient(180deg,#00f2ff,#0088ff); 
            color: #fff; 
            border: none; 
            cursor: pointer;
            font-family: "Orbitron", sans-serif;
            font-weight: 700;
        }
        
        .button:hover {
            background: linear-gradient(180deg,#0088ff,#00f2ff);
            transform: scale(1.05);
        }

        #winnerBox {
            display: none;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(0, 0, 0, 0.95);
            color: #fff;
            padding: 3rem;
            border-radius: 16px;
            text-align: center;
            z-index: 1000;
            box-shadow: 0 0 30px rgba(0, 242, 255, 0.8);
            border: 3px solid #00f2ff;
        }

        #winnerBox h2 {
            font-size: 3rem;
            margin-bottom: 1rem;
            text-shadow: 0 0 20px rgba(0, 255, 255, 0.8);
        }

        #winnerBox p {
            font-size: 1.5rem;
            margin-bottom: 2rem;
        }

        #questionBox {
            display: none;
            margin-top: 1rem;
            background: #222;
            color: #fff;
            padding: 1rem;
            border-radius: 8px;
            width: 100%;
            max-width: 500px;
        }
    </style>
</head>
<body>

<h1>Mód: @mode</h1>

<div style="background: #8AAAEB; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; width: 100%; max-width: 500px;">
    <p><strong>ID hry:</strong> <span id="gameId">@gameId</span></p>
    <p><strong>Tvoje ID:</strong> <span id="myId">@playerId</span></p>
    <p><strong>Hráči v lobbyi:</strong> <span id="playerList"></span></p>
    <p><strong>Počet hráčů:</strong> <span id="playerCount">@playerCount</span></p>
</div>

<div id="gridWrapper" style="display:grid; grid-template-columns: repeat(5, 1fr); gap:12px; max-width:420px; margin-bottom:1rem;">
    @* Grid s 25 tlačítky se vytvoří dynamicky JavaScriptem *@
</div>

<div id="winnerBox" style="display:none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: rgba(0,0,0,0.95); color: #fff; padding: 3rem; border-radius: 16px; text-align: center; z-index: 1000; box-shadow: 0 0 30px rgba(0,242,255,0.8); border: 3px solid #00f2ff;">
    <h2 style="font-size: 3rem; margin-bottom: 1rem; text-shadow: 0 0 20px rgba(0,255,255,0.8);">🎉 VÍTĚZ! 🎉</h2>
    <p id="winnerText" style="font-size: 1.5rem; margin-bottom: 2rem;"></p>
    <button onclick="window.location.href='/Games/Vyber'" class="button" style="font-size: 1.2rem; padding: 1rem 2rem;">Nová hra</button>
    <button onclick="window.location.href='/Home/Index'" class="button" style="font-size: 1.2rem; padding: 1rem 2rem; margin-left: 1rem;">Hlavní menu</button>
</div>

<div id="questionBox" style="display:none; margin-top:1rem; background:#222; color:#fff; padding:1rem; border-radius:8px; width: 100%; max-width: 500px;">
    <div id="questionText" style="margin-bottom:0.5rem;"></div>
    <div id="answerArea" style="display:flex; gap:.5rem;">
        <input id="answerInput" type="text" placeholder="Tvoje odpověď" style="flex:1;padding:.5rem;border-radius:4px;border:1px solid #ccc;" />
        <button id="submitAnswerBtn" class="button" style="min-width:110px">Odeslat</button>
    </div>
</div>

<script>
    const gameIdElem = document.getElementById('gameId');
    const myId = parseInt(document.getElementById('myId').textContent, 10);
    const gridWrapper = document.getElementById('gridWrapper');
    const questionBox = document.getElementById('questionBox');
    const questionText = document.getElementById('questionText');
    const answerInput = document.getElementById('answerInput');
    const submitAnswerBtn = document.getElementById('submitAnswerBtn');
    let localPending = null;
    const playerId = @playerId;

    // Vytvoření gridu 5x5
    function renderEmptyGrid() {
        gridWrapper.innerHTML = '';
        for (let i = 0; i < 25; i++) {
            const btn = document.createElement('button');
            btn.className = 'cellButton';
            btn.dataset.cellid = i;
            btn.textContent = String.fromCharCode(65 + i); // A-Y
            btn.style.padding = '12px';
            btn.style.borderRadius = '10px';
            btn.style.fontWeight = '700';
            btn.style.fontSize = '1rem';
            btn.style.cursor = 'pointer';
            btn.style.background = '#888';
            btn.onclick = onCellClick;
            gridWrapper.appendChild(btn);
        }
    }

    function onCellClick(e) {
        const btn = e.currentTarget;
        const cellId = parseInt(btn.dataset.cellid, 10);
        
        if (localPending) { 
            alert('Na tuto otázku se čeká, dokončete ji.'); 
            return; 
        }

        fetch(`/Games/RequestQuestion?gameId=${gameIdElem.textContent}&pid=${myId}&cellId=${cellId}`, { method: 'POST' })
            .then(r => r.json())
            .then(json => {
                if (json.error) return alert(json.error);
                if (json.question) {
                    showQuestion(json.question, cellId);
                }
            })
            .catch(err => console.error(err));
    }

    function showQuestion(text, cellId) {
        localPending = { cellId: cellId, askedBy: myId };
        questionText.textContent = text;
        answerInput.value = '';
        questionBox.style.display = 'block';
        answerInput.focus();
    }

    submitAnswerBtn.addEventListener('click', submitAnswer);
    
    // Přidání funkce pro Enter key
    answerInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
            submitAnswer();
        }
    });
    
    function submitAnswer() {
        if (!localPending) return;
        const ans = answerInput.value || '';
        fetch(`/Games/SubmitAnswer?gameId=${gameIdElem.textContent}&pid=${myId}&cellId=${localPending.cellId}&answer=${encodeURIComponent(ans)}`, { method: 'POST' })
            .then(r => r.json())
            .then(json => {
                if (json.error) { alert(json.error); return; }
                
                // Kontrola výhry
                if (json.isGameOver) {
                    updateGridFromState(json);
                    localPending = null;
                    questionBox.style.display = 'none';
                    return;
                }
                
                updateGridFromState(json);
                localPending = null;
                questionBox.style.display = 'none';
            })
            .catch(err => console.error(err));
    }

    function updateGridFromState(res) {
        if (!res.cellId && !res.grid) return;
        fetch(`/Games/GetGameState?gameId=${gameIdElem.textContent}`)
            .then r => r.json())
            .then(json => {
                if (json.error) return;
                applyStateToGrid(json);
            });
    }

    function applyStateToGrid(state) {
        const buttons = Array.from(document.getElementsByClassName('cellButton'));
        const hasEnoughPlayers = state.canStart;
        
        // Kontrola výhry
        if (state.isGameOver) {
            showWinner(state);
            // Zablokovat všechna tlačítka
            buttons.forEach(btn => {
                btn.disabled = true;
                btn.style.cursor = 'not-allowed';
            });
            return;
        }
        
        // Aktualizace informací o hře
        if (state.mode === "2v2" && state.teams) {
            const blueTeam = state.players.filter(p => state.teams[p] === "blue");
            const orangeTeam = state.players.filter(p => state.teams[p] === "orange");
            document.getElementById('playerList').innerHTML = `
                <div style="color:#00aaff">Modrý tým: ${blueTeam.join(", ")}</div>
                <div style="color:#ff8c00">Oranžový tým: ${orangeTeam.join(", ")}</div>
                <div>Potřeba hráčů: ${state.playerCount}/${state.requiredPlayers}</div>
            `;
        } else {
            document.getElementById('playerList').innerHTML = `
                Hráči: ${state.players.join(', ')} (${state.playerCount}/${state.requiredPlayers})
            `;
        }

        document.getElementById('playerCount').textContent = state.playerCount;

        // Pokud není grid inicializován
        if (!state.grid || state.grid.length === 0) {
            buttons.forEach(btn => {
                btn.style.background = '#cccccc';
                btn.disabled = true;
                btn.style.cursor = 'not-allowed';
            });
            return;
        }

        state.grid.forEach(g => {
            const btn = buttons[g.id];
            if (!btn) return;
            
            btn.textContent = g.label;
            btn.style.color = '#000';
            
            if (g.isAnswered && g.ownerPlayerId > 0) {
                // Správně zodpovězeno
                if (state.mode === "2v2") {
                    btn.style.background = g.team === "blue" ? '#00aaff' : '#ff8c00';
                } else {
                    if (g.ownerPlayerId == parseInt(myId)) {
                        btn.style.background = '#00aaff';
                    } else {
                        btn.style.background = '#ff8c00';
                    }
                }
                btn.disabled = true;
                btn.style.cursor = 'not-allowed';
            } else if (g.ownerPlayerId === -1) {
                // Špatně zodpovězeno - černá
                btn.style.background = '#333';
                btn.style.color = '#fff';
                btn.disabled = false;
                btn.style.cursor = 'pointer';
            } else {
                // Nezodpovězeno
                if (!hasEnoughPlayers) {
                    btn.style.background = '#aaaaaa';
                    btn.disabled = true;
                    btn.style.cursor = 'not-allowed';
                } else {
                    btn.style.background = '#666666';
                    btn.disabled = false;
                    btn.style.cursor = 'pointer';
                }
            }

            // Kontrola tahu
            if (hasEnoughPlayers && state.currentTurn !== myId) {
                btn.disabled = true;
                btn.style.cursor = 'not-allowed';
                btn.style.opacity = '0.7';
            } else if (hasEnoughPlayers && state.currentTurn === myId) {
                if (!g.isAnswered || g.ownerPlayerId === -1) {
                    btn.disabled = false;
                    btn.style.cursor = 'pointer';
                    btn.style.opacity = '1';
                }
            } else if (state.mode === "Procvičení") {
                if (!g.isAnswered || g.ownerPlayerId === -1) {
                    btn.disabled = false;
                    btn.style.cursor = 'pointer';
                    btn.style.opacity = '1';
                }
            }
        });
    }

    function showWinner(state) {
        const winnerBox = document.getElementById('winnerBox');
        const winnerText = document.getElementById('winnerText');
        
        if (state.mode === "2v2" && state.winnerTeam) {
            const teamName = state.winnerTeam === "blue" ? "MODRÝ TÝM" : "ORANŽOVÝ TÝM";
            const teamColor = state.winnerTeam === "blue" ? "#00aaff" : "#ff8c00";
            winnerText.innerHTML = `<span style="color: ${teamColor}; font-weight: bold;">${teamName}</span> vyhrál!`;
        } else if (state.winnerId) {
            if (state.winnerId == myId) {
                winnerText.innerHTML = '<span style="color: #00ff00; font-weight: bold;">TY JSI VYHRÁL!</span>';
            } else {
                winnerText.innerHTML = `Hráč <span style="color: #ff8c00; font-weight: bold;">${state.winnerId}</span> vyhrál!`;
            }
        }
        
        winnerBox.style.display = 'block';
        questionBox.style.display = 'none';
    }

    // Polling stavu každou sekundu
    setInterval(() => {
        fetch(`/Games/GetGameState?gameId=${gameIdElem.textContent}`)
            .then(r => r.json())
            .then(json => {
                if (json.error) { console.error(json.error); return; }
                applyStateToGrid(json);
            })
            .catch(e => console.error(e));
    }, 1000);

    // Inicializace
    renderEmptyGrid();
    fetch(`/Games/GetGameState?gameId=${gameIdElem.textContent}`)
        .then(r => r.json())
        .then(json => {
            if (!json.error) {
                applyStateToGrid(json);
            }
        });
</script>

</body>
</html>