<h1>Výběr herního módu</h1>

<form id="gameForm">
    <label for="playerId">Zadej ID hráče:</label>
    <input type="number" id="playerId" name="playerId" min="1" required style="margin-bottom:1rem;" />

    <div style="display:flex; flex-direction:column; gap:1rem; width:220px; margin-top:1rem;">
        <button type="button" class="button" onclick="goToMode('Procviceni')">Procvičení</button>
        <button type="button" class="button" onclick="goToMode('OneVOne')">1v1</button>
        <button type="button" class="button" onclick="goToMode('TwoVTwo')">2v2</button>
    </div>
</form>

<script>
    function goToMode(mode) {
        const pid = document.getElementById('playerId').value;
        if (!pid) {
            alert('Zadej prosím ID hráče.');
            return;
        }
        window.location.href = `/Games/${mode}?pid=${pid}`;
    }
</script>

<style>
    .button {
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        padding: 1rem;
        border-radius: 12px;
        font-size: 1.2rem;
        font-weight: 700;
        background: linear-gradient(180deg,#00f2ff,#0088ff);
        color: #fff;
        box-shadow: 0 0 14px rgba(0,136,255,0.6);
        transition: transform .15s ease, box-shadow .15s ease;
        border: none;
        cursor: pointer;
    }

        .button:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(0,242,255,0.9);
        }

        .button:active {
            transform: scale(0.97);
        }
</style>