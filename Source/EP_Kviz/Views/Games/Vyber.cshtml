<h1>Výběr herního módu</h1>
<a href="/Home/Index" class="home-button">Zpět</a>

@if (TempData["Error"] != null)
{
    <div style="color: red; padding: 1rem; background: #ffe0e0; border-radius: 8px; margin-bottom: 1rem;">
        @TempData["Error"]
    </div>
}

<form id="gameForm">
    <label for="playerId">Tvé ID:</label>
    <input type="number" id="playerId" name="playerId" min="1" required style="margin-bottom:1rem;" value="@ViewBag.UserId" readonly />

    <h3>Vytvořit novou hru:</h3>
    <div style="display:flex; flex-direction:column; gap:1rem; width:220px; margin-bottom:2rem;">
        <button type="button" class="button" onclick="goToMode('Procviceni')">Procvičení</button>
        <button type="button" class="button" onclick="goToMode('OneVOne')">1v1</button>
        <button type="button" class="button" onclick="goToMode('TwoVTwo')">2v2</button>
    </div>

    <h3>Nebo se připoj k existující hře:</h3>
    <label for="joinGameId">ID hry:</label>
    <input type="number" id="joinGameId" name="joinGameId" min="100000" max="999999" style="margin-bottom:0.5rem;" />
    <button type="button" class="button button-secondary" onclick="joinGame()">Připojit se</button>
</form>

<script>
    function goToMode(mode) {
        const pid = document.getElementById('playerId').value;
        if (!pid) {
            alert('Zadej prosím své ID.');
            return;
        }
        window.location.href = `/Games/${mode}?pid=${pid}`;
    }

    function joinGame() {
        const pid = document.getElementById('playerId').value;
        const gameId = document.getElementById('joinGameId').value;

        if (!pid) {
            alert('Zadej prosím své ID.');
            return;
        }
        if (!gameId) {
            alert('Zadej prosím ID hry.');
            return;
        }

        window.location.href = `/Games/Join?gameId=${gameId}&pid=${pid}`;
    }
</script>

<style>
    .container {
        max-width: 600px;
        margin: 0 auto;
        padding: 2rem;
        background: #f9f9f9;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .button-group {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .button {
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        padding: 1rem;
        border-radius: 12px;
        font-size: 1.2rem;
        font-weight: 700;
        background: linear-gradient(180deg,#00f2ff,#0088ff);
        color: #fff;
        box-shadow: 0 0 14px rgba(0,136,255,0.6);
        transition: transform .15s ease, box-shadow .15s ease;
        border: none;
        cursor: pointer;
        width: 100%;
    }

        .button:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(0,242,255,0.9);
        }

        .button:active {
            transform: scale(0.97);
        }

    .button-secondary {
        background: linear-gradient(180deg,#6c757d,#495057);
        box-shadow: 0 0 14px rgba(108,117,125,0.6);
    }

        .button-secondary:hover {
            box-shadow: 0 0 20px rgba(108,117,125,0.9);
        }

    label {
        margin-bottom: 0.5rem;
        font-weight: 500;
    }

    input[type="number"] {
        width: 100%;
        padding: 0.75rem;
        border-radius: 8px;
        border: 1px solid #ccc;
        margin-bottom: 1rem;
        font-size: 1rem;
    }

    h3 {
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
        font-size: 1.2rem;
        color: #333;
    }

    
    .home-button {
        position: absolute;
        top: 24px;
        right: 32px;
        padding: 0.7rem 1.4rem;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 700;
        background: linear-gradient(180deg,#00f2ff,#0088ff);
        color: #fff;
        text-decoration: none;
        box-shadow: 0 0 10px rgba(0,136,255,0.5);
        transition: transform .15s, box-shadow .15s;
        z-index: 10;
    }

    .home-button:hover {
        transform: scale(1.07);
        box-shadow: 0 0 18px rgba(0,242,255,0.8);
    }
</style>
