@{
    ViewData["Title"] = "Výběr herního módu";
}

<h1>Výběr herního módu</h1>
<a href="/Home/Index" class="home-button">Zpět</a>

@if (TempData["Error"] != null)
{
    <div style="color: red; padding: 1rem; background: #ffe0e0; border-radius: 8px; margin-bottom: 1rem;">
        @TempData["Error"]
    </div>
}

<div>
    <label for="playerId_display">Tvé ID:</label>
    <input type="number"
           id="playerId_display"
           class="uzivatelske_ID"
           value="@ViewBag.UserId"
           readonly
           disabled
           style="margin-bottom:1rem; width:100%;" />

    <h3>Vytvořit novou hru:</h3>
    <div style="display:flex; flex-direction:column; gap:1rem; width:220px; margin-bottom:2rem;">
        <a href="/Games/Procviceni?pid=@ViewBag.UserId" class="button">Procvičení</a>
        <a href="/Games/OneVOne?pid=@ViewBag.UserId" class="button">1v1</a>
        <a href="/Games/TwoVTwo?pid=@ViewBag.UserId" class="button">2v2</a>
        <a href="/Games/Duel?pid=@ViewBag.UserId" class="button">🔥 Duel</a>
    </div>

    <h3>Nebo se připoj k existující hře:</h3>
    <form method="get" action="/Games/Join" id="joinForm">
        <input type="hidden" name="pid" value="@ViewBag.UserId" />
        <label for="joinGameId">ID hry:</label>
        <input type="number" id="joinGameId" name="gameId" min="100000" max="999999" style="margin-bottom:0.5rem;" required />
        <button id="joinButton" type="submit" class="button-secondary">Připojit se</button>
    </form>
</div>

<style>
    .button, .button-secondary {
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        padding: 1rem;
        border-radius: 12px;
        font-size: 1.2rem;
        font-weight: 700;
        color: #fff;
        box-shadow: 0 0 14px rgba(0,136,255,0.6);
        transition: transform .15s ease, box-shadow .15s ease, opacity .15s;
        border: none;
        cursor: pointer;
        width: 100%;
        min-height: 48px;
        box-sizing: border-box;
    }

    .button {
        background: linear-gradient(180deg,#00f2ff,#0088ff);
        box-shadow: 0 0 14px rgba(0,136,255,0.6);
    }
    .button:hover { transform: scale(1.05); box-shadow: 0 0 20px rgba(0,242,255,0.9); }
    .button:active { transform: scale(0.97); }

    .button-secondary {
        background: linear-gradient(180deg,#6c757d,#495057);
        box-shadow: 0 0 14px rgba(108,117,125,0.6);
    }
    .button-secondary:hover { box-shadow: 0 0 20px rgba(108,117,125,0.9); }

    h3 {
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
        font-size: 1.2rem;
        color: white;
    }

    .home-button {
        position: absolute;
        top: 24px;
        right: 32px;
        padding: 0.7rem 1.4rem;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 700;
        background: linear-gradient(180deg,#00f2ff,#0088ff);
        color: #fff;
        text-decoration: none;
        box-shadow: 0 0 10px rgba(0,136,255,0.5);
        transition: transform .15s, box-shadow .15s;
        z-index: 10;
    }

    .home-button:hover {
        transform: scale(1.07);
        box-shadow: 0 0 18px rgba(0,242,255,0.8);
    }

    label {
        margin-bottom: 0.5rem;
        font-weight: 500;
        color: #ccc;
        display: block;
    }

    input[type="number"] {
        width: 100%;
        padding: 0.75rem;
        border-radius: 8px;
        border: 1px solid #fff;
        margin-bottom: 1rem;
        font-size: 1rem;
    }

    .uzivatelske_ID {
        color: white;
    }
</style>
